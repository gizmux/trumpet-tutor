{
  "name": "Trumpet Tutor",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y poppler-utils && pip install -r requirements.txt && homr --init",
  "postAttachCommand": {
    "server": "cd app && uvicorn server:app --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Trumpet Tutor", "onAutoForward": "openBrowser" }
  }
}
